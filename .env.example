# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.

# Base de datos Postgres (Neon u otro servidor). Ejemplo Neon:
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/observatorio?sslmode=require
# Si se deja vacío se usa SQLite local (./observatorio_local.db), útil para pruebas.
DATABASE_URL=

# OpenRouter: solo se usa el endpoint gratuito openrouter/free. Opcional.
OPENROUTER_API_KEY=

# Login con Google (ID de cliente OAuth, no es secreto)
GOOGLE_CLIENT_ID=745533004054-gub9dlpg373msnfq05gnhev4jjethhp9.apps.googleusercontent.com
# Dominio permitido para iniciar sesión
DOMINIO_PERMITIDO=unal.edu.co
# Administradores iniciales (separados por coma)
ADMINS_INICIALES=uniic_bog@unal.edu.co,clagosm@unal.edu.co

# Secreto para firmar las sesiones (genere uno largo y aleatorio: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
JWT_HORAS=12

# Lanzar corridas en GitHub Actions desde el aplicativo
# Token fine-grained con permiso "Actions: Read and write" sobre el repositorio
GITHUB_TOKEN=
GITHUB_REPO=its-camilo/observatorio-empleo-fce
GITHUB_WORKFLOW=corrida.yml
GITHUB_REF=main

# Proxies opcionales para el scraping, separados por coma (http://usuario:clave@host:puerto). Vacío = sin proxy.
PROXIES=

# Token opcional para proteger las URL CSV de Power BI (?token=...). Vacío = públicas.
CSV_TOKEN=

# Solo para desarrollo local: permite /api/auth/dev sin Google. NUNCA activar en producción.
AUTH_DEV_MODE=false
